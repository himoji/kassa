# Kassa configuration (spec §20). Copy to .env; generate secrets with `bun run keys:generate`.
# Never commit real keys; test keys only.

DATABASE_URL=postgres://kassa:kassa@postgres:5432/kassa
PUBLIC_ORIGIN=https://<domain>          # WebAuthn origin
RP_ID=<domain>
SESSION_SECRET=
RULES_SIGNING_KEY=                      # Ed25519 private (base64)
RULES_PUBLIC_KEY=                       # given to payments
LEDGER_CHECKPOINT_KEY=
ACCOUNT_ENC_KEY=                        # AES-256-GCM for payee account details
MOCK_HMAC_SECRET=

# LLM (provider-agnostic, Vercel AI SDK; see docs/DECISIONS.md).
# Model strings are `provider:model`, provider one of: anthropic | openai | google | local
# (`local` = any OpenAI-compatible endpoint at LOCAL_BASE_URL, e.g. Ollama).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=
PLANNER_MODEL=anthropic:claude-sonnet-5-5
READER_MODEL=anthropic:claude-haiku-5-5
AGENT_MODE=LIVE                         # or REPLAY

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
ISSUING_PROVIDER=stripe                 # or fake
PAYMENTS_DAILY_CAP_HOME_MINOR=50000000  # ₸500,000
DEMO_ENABLED=true
DEMO_ADMIN_TOKEN=
MOCK_WORLD_URL=http://mock-world:4001
