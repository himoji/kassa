# Kassa configuration (spec §20). Copy to .env; generate secrets with `bun run keys:generate`.
# Never commit real keys; test keys only.

DATABASE_URL=postgres://kassa:kassa@postgres:5432/kassa
PUBLIC_ORIGIN=https://<domain>          # WebAuthn origin
RP_ID=<domain>
SESSION_SECRET=
RULES_SIGNING_KEY=                      # Ed25519 private (base64)
RULES_PUBLIC_KEY=                       # given to payments
LEDGER_CHECKPOINT_KEY=
ACCOUNT_ENC_KEY=                        # AES-256-GCM for payee account details
MOCK_HMAC_SECRET=

# LLM (provider-agnostic, Vercel AI SDK; see docs/DECISIONS.md).
# Model strings are `provider:model`, provider one of: anthropic | openai | google | local
# (`local` = any OpenAI-compatible endpoint at LOCAL_BASE_URL, e.g. Ollama).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=
PLANNER_MODEL=anthropic:claude-sonnet-5-5
READER_MODEL=anthropic:claude-haiku-5-5
AGENT_MODE=LIVE                         # or REPLAY

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
ISSUING_PROVIDER=stripe                 # or fake
PAYMENTS_DAILY_CAP_HOME_MINOR=200000000 # ₸500,000
DEMO_ENABLED=true
DEMO_ADMIN_TOKEN=
MOCK_WORLD_URL=http://mock-world:4001

# --- added by bun run env:setup ---
RP_NAME=Kassa
EXTRA_ORIGINS= # comma-separated extra WebAuthn origins
LEDGER_CHECKPOINT_PUBLIC_KEY= # optional; derived from LEDGER_CHECKPOINT_KEY when unset
LOCAL_VISION=false # set true if the local model accepts images
RECORD= # 1 = record live agent runs to fixtures/agent-recordings
STRIPE_ISSUING_CURRENCY= # currency of the Stripe Issuing balance (e.g. EUR)
SCHEDULER_ENABLED=true
API_URL=http://localhost:4000 # mock-world → API
MOCK_PUBLIC_URL=http://localhost:4001 # public base URL of mock-world pages
MOCK_BANK_STEP_SECONDS= # optional; demo-clock seconds per mock transfer state
MOCK_BANK_TICK_MS= # optional; mock bank status tick interval

# --- added by bun run env:setup ---
USER_KEK= # AES-256-GCM key-encryption key for per-user data keys (GDPR erasure = crypto-shredding)
TRUST_PROXY= # unset = socket address; true behind a proxy that overwrites X-Forwarded-For (docker-compose Caddy); or IP/CIDR list
RATE_LIMIT_GLOBAL_PER_MIN=600 # requests per minute per IP, all routes
RATE_LIMIT_AUTH_PER_MIN=20 # auth options/verify, refresh, public verify
RATE_LIMIT_SENSITIVE_PER_MIN=30 # order approve, capture shortcut, privacy, unfreeze
RETENTION_DAYS_NOTIFICATIONS=90 # purge job; 0 = keep
RETENTION_DAYS_PLACEHOLDER_MAPS=30 # agent conversations + placeholder maps
RETENTION_DAYS_DOCUMENTS=30 # uploaded documents (invoices, screenshots)
RETENTION_DAYS_CAPTURED_TEXT=90 # raw merchant text of captured purchases

# --- added by bun run env:setup ---
FX_OFFLINE= # 1 = use fixtures/fx-rates.json example rates (no network)

# --- added by bun run env:setup ---
PAYMENTS_DAILY_CAP_CURRENCY=KZT # reference currency of PAYMENTS_DAILY_CAP_HOME_MINOR
SMALL_AUTO_DAILY_MAX_COUNT=3 # small-auto (T1 without mandate) payments per UTC day; then ASK SMALL_AUTO_BUDGET_EXHAUSTED
SMALL_AUTO_DAILY_AMOUNT_MULTIPLE=3 # small-auto total per day = this × the signed small-auto limit
