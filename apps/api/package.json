    "@ai-sdk/provider": "^4.0.26",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@kassa/shared": "workspace:*",
    "@simplewebauthn/server": "^14.0.3",
    "ai": "^7.0.137",
