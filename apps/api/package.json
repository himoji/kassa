{
  "name": "@kassa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "bun scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "seed": "bun scripts/seed.ts",
    "ledger:verify": "bun scripts/ledger-verify.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/provider": "^4.0.26",
    "@fastify/multipart": "^10.1.3",
    "@kassa/shared": "workspace:*",
    "ai": "^7.0.137",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
