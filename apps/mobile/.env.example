# Copy to .env and adjust. Only EXPO_PUBLIC_* keys are visible to app code.
# APP_VARIANT drives app.config.ts: dev | preview | prod
APP_VARIANT=dev
# Same value, visible to app code via src/lib/env.ts (eas.json sets both per profile).
EXPO_PUBLIC_APP_VARIANT=dev

# TanStack Query
# Kassa API (dev: the api workspace directly; behind Caddy the web build uses same-origin /api)
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# --- added by bun run env:setup ---
EXPO_PUBLIC_DEMO_ADMIN_TOKEN= # dev/demo only — same value as DEMO_ADMIN_TOKEN
