  },
  "dependencies": {
    "@expo/ui": "~57.0.22",
    "@hookform/resolvers": "^5.9.1",
    "@kassa/shared": "workspace:*",
    "@rn-primitives/slot": "^1.5.2",
    "@tanstack/react-query": "^5.103.2",
    "burnt": "^0.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.27",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "nativewind": "4.2.7",
    "pressto": "^0.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@jest/globals": "~29.7.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.3.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "//": "scripts/* live at the root of the assembled buyer repo. They run under plain node (>=22.18 strips TypeScript natively; setup and doctor run scripts/check-node.cjs first, which says so on an older node), so any package manager works; --no-warnings silences MODULE_TYPELESS_PACKAGE_JSON, which node emits because this package.json has no \"type\" - the metro/babel/jest configs next to it are CommonJS .js.",
    "start": "expo start --dev-client",
    "start:dev": "expo start --dev-client",
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:e2e": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e.ts",
    "setup": "echo 'Already applied - setup is one-way and removed itself (see .readynative.json).' #",
    "doctor": "node scripts/check-node.cjs && node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/doctor.ts",
    "gen:theme": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-theme.ts",
    "gen:links": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-links.ts",
    "gen:privacy": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-privacy.ts",
    "gen:assets": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-assets.ts",
    "gen:graph": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-graph.ts",
    "gen": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/gen.ts",
    "push:test": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/push-test.ts"
  },
  "private": true
}
