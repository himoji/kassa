exports[`gen-theme-nativewind4 renders global.css with :root / .dark:root triples and radius vars 1`] = `
"@tailwind base;
@tailwind components;
@tailwind utilities;

/* Generated by \`bun gen:theme\` from src/theme/tokens.ts - edit tokens, not this file. */
@layer base {
  :root {
    --background: 0 0% 100%;
    --foreground: 0 0% 3.9%;
    --primary: 0 0% 9%;
    --primary-foreground: 0 0% 98%;
    --destructive: 357.1 100% 45.3%;
    --border: 0 0% 89.8%;
    --radius: 12px;
    --radius-md: 10px;
    --radius-sm: 8px;
  }

  /* \`darkMode: "class"\`: applied when NativeWind's colorScheme is dark. */
  .dark:root {
    --background: 0 0% 3.9%;
    --foreground: 0 0% 98%;
    --primary: 0 0% 89.8%;
    --primary-foreground: 0 0% 9%;
    --destructive: 358.8 100% 69.6%;
    --border: 0 0% 13.7%; /* #ffffff1a flattened onto #0a0a0a */
  }
}
"
`;

