{
  "name": "kassa",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@kassa/api --filter=@kassa/mock-world",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "keys:generate": "bun scripts/keys-generate.ts",
    "env:setup": "bun scripts/env-setup.ts",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "seed": "bun run --cwd apps/api seed",
    "ledger:verify": "bun run --cwd apps/api ledger:verify",
    "eval:invoices": "bun run --cwd apps/api eval:invoices",
    "ledger:anchor": "bun run --cwd apps/api ledger:anchor",
    "ledger:anchor:verify": "bun run --cwd apps/api ledger:anchor:verify",
    "evidence:attacks": "rm -f docs/evidence/attacks.json docs/evidence/naive-baseline.json && WRITE_EVIDENCE=1 bun run --cwd apps/api vitest run test/attacks test/naive",
    "sim": "bun apps/api/scripts/sim/cli.ts",
    "phone": "bun scripts/phone.ts",
    "demo:video": "bun scripts/demo-video/record.ts",
    "dev:all": "bun scripts/dev-all.ts",
    "dev:tunnel": "bun scripts/dev-tunnel.ts",
    "lite:ios": "bun scripts/lite.ts",
    "ota": "bun scripts/ota.ts",
    "vercel-build": "bun scripts/vercel-build.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "qrcode": "^1.5.4",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "//patchedDependencies": "Moved from apps/mobile/package.json: bun applies patches from the workspace root only. Pinned exactly: a patch applies to one version.",
  "patchedDependencies": {
    "react-native-screens@4.26.2": "apps/mobile/patches/react-native-screens@4.26.2.patch"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11"
  }
}
